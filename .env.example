# everything is optional, except what docker compose needs (MEKIKI_DOMAIN, POSTGRES_PASSWORD) and what
# production needs: signing in (BETTER_AUTH_SECRET, github and/or sso, who's allowed) and GITHUB_WEBHOOK_SECRET.
# mekiki refuses to start in production without a working sign-in. under docker compose, MEKIKI_ENV,
# BETTER_AUTH_URL, the paths, HOST, PORT, MEKIKI_LOG_FORMAT and MEKIKI_TRUST_PROXY are set for you (the commented ones below)

# docker compose: the domain caddy gets an https certificate for. point its dns at the vps first
MEKIKI_DOMAIN=mekiki.example.com
# docker compose: the postgres container's password, which mekiki's DATABASE_URL is made with.
# letters and digits only (it goes into a url): `openssl rand -hex 24`
POSTGRES_PASSWORD=

# server
# PORT=7420
# HOST=127.0.0.1
# postgres (set for you under docker compose)
# DATABASE_URL=postgres://mekiki:mekiki@127.0.0.1:5432/mekiki

# development | production. production (the docker image) refuses to start until signing in is set up;
# so does listening beyond this machine (HOST other than 127.0.0.1 / ::1 / localhost)
# MEKIKI_ENV=development

# development: hosts besides localhost the dashboard answers to, comma separated: a tunnel (cloudflared,
# ngrok) pointed at http://localhost:7421, so github's webhooks reach this machine. set BETTER_AUTH_URL to it too
# MEKIKI_DEV_HOSTS=mekiki.example.com

# ---------- signing in to the dashboard (better auth). see docs/operations.md for each provider ----------
# where people open mekiki: https://MEKIKI_DOMAIN under docker compose, http://localhost:7421 in development
# BETTER_AUTH_URL=https://mekiki.example.com
# signs sessions, encrypts the oauth tokens kept: `openssl rand -base64 32`. changing it signs everyone out
BETTER_AUTH_SECRET=
MEKIKI_SESSION_DAYS=7
# behind a reverse proxy: trust its X-Forwarded-For (sign-in rate limits per client)
# MEKIKI_TRUST_PROXY=false

# sign in with github: an oauth app (or your github app's client id and secret).
# callback url: https://MEKIKI_DOMAIN/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# sign in with the company's identity provider (okta, entra id, google workspace, keycloak, authentik…)
# oidc: redirect uri https://MEKIKI_DOMAIN/api/auth/sso/callback/sso
# MEKIKI_SSO_NAME=Okta
# MEKIKI_SSO_ISSUER=https://acme.okta.com
# MEKIKI_SSO_CLIENT_ID=
# MEKIKI_SSO_CLIENT_SECRET=
# MEKIKI_SSO_DISCOVERY_URL=   (default: the issuer's /.well-known/openid-configuration)
# or saml: the idp's metadata xml, mounted into the container. acs https://MEKIKI_DOMAIN/api/auth/sso/saml2/sp/acs/sso,
# entity id https://MEKIKI_DOMAIN/api/auth/sso/saml2/sp/metadata?providerId=sso
# MEKIKI_SSO_SAML_METADATA_FILE=/data/idp-metadata.xml
# the company's email domain (needed for sso): whoever the sso signs in with an address there is let in
# MEKIKI_SSO_DOMAIN=acme.com

# who may sign in, besides the sso's domain: addresses and whole domains (github's must be verified there)…
# MEKIKI_ALLOWED_EMAILS=alice@acme.com,@acme.com
# …and members of these github organizations (signing in with github asks for read:org)
# MEKIKI_ALLOWED_GITHUB_ORGS=acme

# github, one of: a github app (its own rate limits, comments under its name), a token, or the `gh` cli's login
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=/data/github-app.pem
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_MAX_BYTES=5242880
# GITHUB_API_URL=https://api.github.com

# who may start a review from github (a /mekiki comment, a ticked box, a label): their least permission on
# the repository (read | triage | write | maintain | admin), and how many they and each pull request get an hour.
# in auto mode, a pull request whose author lacks it gets the checkboxes instead of a review
MEKIKI_TRIGGER_PERMISSION=write
MEKIKI_REVIEWS_PER_USER_HOUR=30
MEKIKI_REVIEWS_PER_PR_HOUR=10

# after each review it posts, mekiki resolves its own threads whose code changed since and whose problem
# it didn't find again (replying "fixed in <sha>"). threads it didn't start are never touched
MEKIKI_RESOLVE_FIXED=true

# agents: logged-in CLIs, billed to your subscription. a subscription login is for one person's own use:
# a team or a company uses the api agent below. false: neither is offered or ever started, the api
# agent reviews alone (the docker image: it has no clis)
# MEKIKI_CLI_AGENTS=true
# CLAUDE_BIN=claude
# CODEX_BIN=codex
# from `claude setup-token`, for headless servers
# CLAUDE_CODE_OAUTH_TOKEN=
# CODEX_HOME=~/.codex
AGENT_TIMEOUT_SECONDS=600
AGENT_CONCURRENCY=4

# the api agent: a model on an API key (billed per token) through the AI SDK. ready once it has a provider,
# a model and that provider's key. the key stays here: never stored, sent to the dashboard, logged, or given to a cli
# openai | anthropic | google
# MEKIKI_API_PROVIDER=anthropic
# MEKIKI_API_MODEL=claude-sonnet-5-5
# more models the dashboard offers
# MEKIKI_API_MODELS=claude-haiku-5-5,claude-opus-5-5
# the provider's own variable: OPENAI_API_KEY | ANTHROPIC_API_KEY | GOOGLE_GENERATIVE_AI_API_KEY
# ANTHROPIC_API_KEY=
# an openai-compatible gateway (openrouter, litellm, azure): with MEKIKI_API_PROVIDER=openai and its key in OPENAI_API_KEY
# MEKIKI_API_BASE_URL=https://openrouter.ai/api/v1
# model calls per review chunk: the last one gets no tools, so it answers
# MEKIKI_API_MAX_STEPS=30
# dollars per million tokens for the cost estimate, on top of src/prices.ts
# MEKIKI_PRICES={"my-model": {"input": 1, "cachedInput": 0.1, "output": 5}}
# reviews running or waiting at once: another is turned away (and its comment says so)
MAX_QUEUED_REVIEWS=20

# the code each review reads: one directory per commit, least recently used pruned
# MEKIKI_CHECKOUTS=.data/checkouts
# a repository needing more than this (git's download on disk, or the tarball) is reviewed on its diff alone
MAX_REPO_MB=500
KEEP_CHECKOUTS=30
# everything under MEKIKI_CHECKOUTS together: the least recently used commits, then repositories, go first
MEKIKI_DISK_BUDGET_MB=20480
# one download (git or the tarball) gives up after this
CHECKOUT_TIMEOUT_SECONDS=300

# docker compose: what the mekiki container may use of the machine
# MEKIKI_CPUS=2
# MEKIKI_MEMORY=4g

# logs: pretty | json (one object per line, for a log collector). an otlp collector gets traces and logs too
# MEKIKI_LOG_FORMAT=pretty
MEKIKI_LOG_LEVEL=Info
# MEKIKI_OTLP_URL=http://otel-collector:4318

# what gets reviewed
MAX_DIFF_CHARS=400000
MAX_FILE_CHARS=80000
CHUNK_CHARS=150000

# defaults until changed in the dashboard
# claude | codex | api
MEKIKI_AGENT=claude
# empty: the agent's default. claude: fable | opus | sonnet | haiku. codex: a slug from `codex debug models`. api: MEKIKI_API_MODEL's
MEKIKI_MODEL=
# light | medium | high: the reasoning effort reviews run at
MEKIKI_DEPTH=light
# when a pull request opens: ask (post Light / Medium / High checkboxes and wait for a tick) | auto (review right away)
MEKIKI_MODE=ask
MEKIKI_POST_COMMENTS=true
MEKIKI_MAX_FINDINGS=10
MEKIKI_MIN_CONFIDENCE=0.6
# github logins whose pull requests are never reviewed on their own and get no comment (/mekiki, a label or the
# dashboard still review them). the team's rules, allowed authors and per-repository settings are set in the dashboard
# MEKIKI_BLOCKED_AUTHORS=dependabot[bot],renovate[bot]
# files never reviewed, on top of lockfiles and generated files. as in .gitignore: *.snap anywhere, /docs/** from the root
# MEKIKI_EXCLUDE=*.snap,/docs/**

# everything is optional, except what docker compose needs (GLANCE_DOMAIN, POSTGRES_PASSWORD) and what
# production needs: signing in (BETTER_AUTH_SECRET, github and/or sso, who's allowed) and GITHUB_WEBHOOK_SECRET.
# glance refuses to start in production without a working sign-in. under docker compose, GLANCE_ENV,
# BETTER_AUTH_URL, the paths, HOST, PORT, GLANCE_LOG_FORMAT and GLANCE_TRUST_PROXY are set for you (the commented ones below)

# docker compose: the domain caddy gets an https certificate for. point its dns at the vps first
GLANCE_DOMAIN=glance.example.com
# docker compose: the postgres container's password, which glance's DATABASE_URL is made with.
# letters and digits only (it goes into a url): `openssl rand -hex 24`
POSTGRES_PASSWORD=

# server
# PORT=7420
# HOST=127.0.0.1
# postgres (set for you under docker compose)
# DATABASE_URL=postgres://glance:glance@127.0.0.1:5432/glance

# development | production. production (the docker image) refuses to start until signing in is set up;
# so does listening beyond this machine (HOST other than 127.0.0.1 / ::1 / localhost)
# GLANCE_ENV=development

# ---------- signing in to the dashboard (better auth). see docs/operations.md for each provider ----------
# where people open glance: https://GLANCE_DOMAIN under docker compose, http://localhost:7421 in development
# BETTER_AUTH_URL=https://glance.example.com
# signs sessions, encrypts the oauth tokens kept: `openssl rand -base64 32`. changing it signs everyone out
BETTER_AUTH_SECRET=
GLANCE_SESSION_DAYS=7
# behind a reverse proxy: trust its X-Forwarded-For (sign-in rate limits per client)
# GLANCE_TRUST_PROXY=false

# sign in with github: an oauth app (or your github app's client id and secret).
# callback url: https://GLANCE_DOMAIN/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# sign in with the company's identity provider (okta, entra id, google workspace, keycloak, authentik…)
# oidc: redirect uri https://GLANCE_DOMAIN/api/auth/sso/callback/sso
# GLANCE_SSO_NAME=Okta
# GLANCE_SSO_ISSUER=https://acme.okta.com
# GLANCE_SSO_CLIENT_ID=
# GLANCE_SSO_CLIENT_SECRET=
# GLANCE_SSO_DISCOVERY_URL=   (default: the issuer's /.well-known/openid-configuration)
# or saml: the idp's metadata xml, mounted into the container. acs https://GLANCE_DOMAIN/api/auth/sso/saml2/sp/acs/sso,
# entity id https://GLANCE_DOMAIN/api/auth/sso/saml2/sp/metadata?providerId=sso
# GLANCE_SSO_SAML_METADATA_FILE=/data/idp-metadata.xml
# the company's email domain (needed for sso): whoever the sso signs in with an address there is let in
# GLANCE_SSO_DOMAIN=acme.com

# who may sign in, besides the sso's domain: addresses and whole domains (github's must be verified there)…
# GLANCE_ALLOWED_EMAILS=alice@acme.com,@acme.com
# …and members of these github organizations (signing in with github asks for read:org)
# GLANCE_ALLOWED_GITHUB_ORGS=acme

# github, one of: a github app (its own rate limits, comments under its name), a token, or the `gh` cli's login
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=/data/github-app.pem
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_MAX_BYTES=5242880
# GITHUB_API_URL=https://api.github.com

# who may start a review from github (a /glance comment, a ticked box, a label): their least permission on
# the repository (read | triage | write | maintain | admin), and how many they and each pull request get an hour.
# in auto mode, a pull request whose author lacks it gets the checkboxes instead of a review
GLANCE_TRIGGER_PERMISSION=write
GLANCE_REVIEWS_PER_USER_HOUR=30
GLANCE_REVIEWS_PER_PR_HOUR=10

# agents: logged-in CLIs, billed to your subscription
# CLAUDE_BIN=claude
# CODEX_BIN=codex
# from `claude setup-token`, for headless servers
# CLAUDE_CODE_OAUTH_TOKEN=
# CODEX_HOME=~/.codex
AGENT_TIMEOUT_SECONDS=600
AGENT_CONCURRENCY=4
# reviews running or waiting at once: another is turned away (and its comment says so)
MAX_QUEUED_REVIEWS=20

# the code each review reads: one directory per commit, least recently used pruned
# GLANCE_CHECKOUTS=.data/checkouts
# a repository needing more than this (git's download on disk, or the tarball) is reviewed on its diff alone
MAX_REPO_MB=500
KEEP_CHECKOUTS=30
# everything under GLANCE_CHECKOUTS together: the least recently used commits, then repositories, go first
GLANCE_DISK_BUDGET_MB=20480
# one download (git or the tarball) gives up after this
CHECKOUT_TIMEOUT_SECONDS=300

# docker compose: what the glance container may use of the machine
# GLANCE_CPUS=2
# GLANCE_MEMORY=4g
# docker compose: the agent clis, at the versions this release was tested with
# CLAUDE_CODE_VERSION=2.1.309
# CODEX_VERSION=0.163.0

# logs: pretty | json (one object per line, for a log collector). an otlp collector gets traces and logs too
# GLANCE_LOG_FORMAT=pretty
GLANCE_LOG_LEVEL=Info
# GLANCE_OTLP_URL=http://otel-collector:4318

# what gets reviewed
MAX_DIFF_CHARS=400000
MAX_FILE_CHARS=80000
CHUNK_CHARS=150000

# defaults until changed in the dashboard
# claude | codex
GLANCE_AGENT=claude
# empty: the CLI's default. claude: fable | opus | sonnet | haiku. codex: a slug from `codex debug models`
GLANCE_MODEL=
# light | medium | high: the reasoning effort reviews run at
GLANCE_DEPTH=light
# when a pull request opens: ask (post Light / Medium / High checkboxes and wait for a tick) | auto (review right away)
GLANCE_MODE=ask
GLANCE_POST_COMMENTS=true
GLANCE_MAX_FINDINGS=10
GLANCE_MIN_CONFIDENCE=0.6

# the dashboard and the api on one origin, with https from let's encrypt for GLANCE_DOMAIN
{$GLANCE_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		# scripts and data from this origin only; kumo and echarts set inline styles; avatars come from github or the sso
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
	}

	# the rpc api, signing in (/api/auth), health and the github webhook. the review stream is one long
	# response: passed on as it's written, not buffered
	handle /api/* {
		reverse_proxy glance:7420 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		# file names with a content hash: cached for good. everything else (index.html) is checked each time
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
